client
dev tun
proto udp4
remote 89.117.37.63 443
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
verify-x509-name weezy-server name
tls-version-min 1.2
auth-user-pass
auth-nocache
auth SHA256
data-ciphers AES-256-GCM:AES-128-GCM:CHACHA20-POLY1305
tun-mtu 1500
mssfix 1360
verb 3
